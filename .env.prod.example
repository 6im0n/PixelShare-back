POSTGRES_DB=pixelshare
POSTGRES_USER=pixelshare
POSTGRES_PASSWORD=change_me_strong_password

# Secrets — generate each with: openssl rand -hex 32
# All three MUST differ in production. Bootstrap throws otherwise.
JWT_SECRET=change_me_64_chars_random
JWT_REFRESH_SECRET=change_me_64_chars_random_different
COOKIE_SECRET=change_me_64_chars_random_different_again

PUBLIC_URL=https://api.pixelshare.srv.simon-gl.fr
# Must match an allowed frontend origin (see main.ts allowlist)
FRONTEND_OAUTH_REDIRECT=https://pixelshare.srv.simon-gl.fr/oauth/callback

# CORS_ORIGIN is ignored — origins hard-coded to:
#   https://pixelshare.srv.simon-gl.fr
#   https://api.pixelshare.srv.simon-gl.fr

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=PixelShare <noreply@pixelshare.srv.simon-gl.fr>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.pixelshare.srv.simon-gl.fr/api/oauth/google/callback
