NODE_ENV=development
BIND_HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://pixelshare:ps@localhost:5432/pixel

# Secrets — generate with: openssl rand -hex 32
# JWT_REFRESH_SECRET and COOKIE_SECRET MUST be set in production and must
# differ from each other and from JWT_SECRET.
JWT_SECRET=change-me-please
JWT_REFRESH_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_PATH=./storage
PUBLIC_URL=http://localhost:3001

# CORS_ORIGIN is no longer read at runtime — origins are hard-coded:
#   prod: https://pixelshare.srv.simon-gl.fr, https://api.pixelshare.srv.simon-gl.fr
#   dev:  + http://localhost:3000, http://localhost:3001 (and 127.0.0.1)

RESEND_API_KEY=
RESEND_FROM=PixelShare <noreply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# Must match one of the hard-coded allowed frontend origins:
#   https://pixelshare.srv.simon-gl.fr
#   http://localhost:3000 / http://localhost:3001
#   http://127.0.0.1:3000 / http://127.0.0.1:3001
FRONTEND_OAUTH_REDIRECT=http://localhost:3000/oauth/callback
